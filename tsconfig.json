{
    "compilerOptions": {
        "lib": ["ES2020", "DOM"],
        "module": "commonjs",
        "target": "ES2022",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "jsx": "react",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "strictNullChecks": true,
        "strictFunctionTypes": false,
        "rootDir": "./packages",
        "paths": {
            "*": ["./packages/*"]
        },
        "sourceMap": false,
        "inlineSourceMap": false,
        "pretty": false,
        "outDir": "./build",
        "skipLibCheck": true,
        "strictPropertyInitialization": false,
        "useDefineForClassFields": true,
        "importHelpers": true,
        "types": ["jquery"]
    },
    "include": ["./packages"]
}
